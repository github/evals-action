{
  "name": "evals-action",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "node tooling/build.mjs",
    "check:dist": "node tooling/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packaged": "node --test tooling/packaged.test.mjs",
    "check:package": "pnpm check:dist && pnpm test:packaged",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm check:dist && pnpm test:packaged"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/core": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@microsoft/vally-cli": "0.21.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
